<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#ECEEF3"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
 <Style TargetType="Button">
  <Setter Property="Foreground" Value="#ECEEF3"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Background" Value="#0B0C0F"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,8"/><Setter Property="Cursor" Value="Hand"/>
  <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
   <Border x:Name="MetalFrame" CornerRadius="15" BorderThickness="1" Padding="1">
    <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><LinearGradientBrush.RelativeTransform><RotateTransform Angle="0" CenterX="0.5" CenterY="0.5"/></LinearGradientBrush.RelativeTransform><GradientStop Color="#31343A" Offset="0"/><GradientStop Color="#ACAFB6" Offset="0.15"/><GradientStop Color="#27292F" Offset="0.30"/><GradientStop Color="#E8EBF0" Offset="0.47"/><GradientStop Color="#404550" Offset="0.60"/><GradientStop Color="#959BAB" Offset="0.77"/><GradientStop Color="#282A30" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
    <Border x:Name="InnerSurface" CornerRadius="13" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
   </Border>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InnerSurface" Property="Background" Value="#17191F"/></Trigger>
    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="MetalFrame" Property="BorderThickness" Value="1.5"/></Trigger>
    <Trigger Property="IsPressed" Value="True"><Setter TargetName="InnerSurface" Property="Opacity" Value="0.75"/></Trigger>
    <EventTrigger RoutedEvent="MouseEnter"><BeginStoryboard x:Name="MetalHover"><Storyboard Timeline.DesiredFrameRate="24"><DoubleAnimation Storyboard.TargetName="MetalFrame" Storyboard.TargetProperty="(Border.BorderBrush).(Brush.RelativeTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:3.5" RepeatBehavior="Forever"/></Storyboard></BeginStoryboard></EventTrigger>
    <EventTrigger RoutedEvent="MouseLeave"><RemoveStoryboard BeginStoryboardName="MetalHover"/></EventTrigger>
    <Trigger Property="IsVisible" Value="False"><Trigger.EnterActions><RemoveStoryboard BeginStoryboardName="MetalHover"/></Trigger.EnterActions></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate></Setter.Value></Setter>
 </Style>
 <Style TargetType="TextBox"><Setter Property="Foreground" Value="#ECEEF3"/><Setter Property="Background" Value="#15171C"/><Setter Property="BorderBrush" Value="#3A3D45"/><Setter Property="Padding" Value="10"/><Setter Property="FontWeight" Value="Bold"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#ECEEF3"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,12,0,5"/></Style>
 <Style TargetType="ComboBox"><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="8"/></Style>
 <Style TargetType="ProgressBar"><Setter Property="Background" Value="#292D35"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="5"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid><Border Background="{TemplateBinding Background}" CornerRadius="3"/><Border x:Name="PART_Track"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ScrollBar"><Setter Property="Width" Value="7"/><Setter Property="Background" Value="#15171C"/></Style>
</ResourceDictionary>
