<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI Battery — gastos" Width="370" Height="610" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E9EDF6"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#E9EDF6"/><Setter Property="Background" Value="#263044"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Border CornerRadius="20" Background="#FA0B0C10" BorderBrush="#464A55" BorderThickness="1" Padding="22">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CONSUMO &amp; GASTOS" FontSize="10" Foreground="#8995AE"/><TextBlock x:Name="ProviderTitle" Text="Codex" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,0"/></StackPanel><Button x:Name="CloseDashboard" Grid.Column="1" Content="×" Width="32" Height="32" VerticalAlignment="Top"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
    <Border x:Name="OperationsCard" Background="#14161C" CornerRadius="14" Padding="16" Margin="0,0,0,12" Visibility="Collapsed"><StackPanel><TextBlock Text="OPERACOES AO VIVO" Foreground="#8995AE" FontSize="10"/><TextBlock x:Name="OperationsSummary" Text="Aguardando eventos locais do Codex" FontSize="12" Margin="0,8,0,10"/><StackPanel x:Name="OperationsList"/><TextBlock Text="US$ estimado: referencia API Standard / contexto curto. Nao e cobranca da assinatura. Tokens por execucao; dados chegam com os eventos locais." FontSize="10" Foreground="#8995AE" Margin="0,10,0,0"/><TextBlock x:Name="OperationsSource" FontSize="10" Foreground="#78849A" Margin="0,6,0,0"/></StackPanel></Border>
    <Border x:Name="AlertBanner" Background="#3C202D" CornerRadius="10" Padding="12" Margin="0,0,0,12" Visibility="Collapsed"><DockPanel><Button x:Name="DismissAlert" DockPanel.Dock="Right" Content="×" Padding="6,0" Background="Transparent"/><TextBlock x:Name="AlertText" Text="Restam 20% ou menos" Foreground="#FF9399" FontWeight="SemiBold"/></DockPanel></Border>
    <Border Background="#14161C" CornerRadius="14" Padding="16" Margin="0,0,0,12"><StackPanel><TextBlock Text="ASSINATURA" Foreground="#8995AE" FontSize="10"/><TextBlock x:Name="SubscriptionPercent" Text="—" FontSize="36" FontWeight="SemiBold" Margin="0,5"/><ProgressBar x:Name="SubscriptionBattery" Height="7" Minimum="0" Maximum="100" Background="#303B50" BorderThickness="0"/><TextBlock x:Name="SubscriptionDetails" FontSize="11" Foreground="#AAB6CC" Margin="0,10,0,0"/></StackPanel></Border>
    <Border Background="#14161C" CornerRadius="14" Padding="16"><StackPanel><TextBlock Text="ORÇAMENTO API" Foreground="#8995AE" FontSize="10"/><TextBlock x:Name="ApiPercent" Text="—" FontSize="36" FontWeight="SemiBold" Margin="0,5"/><ProgressBar x:Name="ApiBattery" Height="7" Minimum="0" Maximum="100" Background="#303B50" BorderThickness="0"/><Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="HOJE" Foreground="#8995AE" FontSize="10"/><TextBlock x:Name="TodayCost" Text="—" FontSize="19" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="MÊS / JANELA" Foreground="#8995AE" FontSize="10"/><TextBlock x:Name="MonthCost" Text="—" FontSize="19" Margin="0,4,0,0"/></StackPanel></Grid><TextBlock x:Name="ApiDetails" FontSize="11" Foreground="#AAB6CC" Margin="0,10,0,0"/></StackPanel></Border>
    <TextBlock Text="100% = saldo disponível. Atualizações dependem da fonte de dados." FontSize="10" Foreground="#78849A" Margin="2,14"/>
   </StackPanel></ScrollViewer>
   <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ConfigureProvider" Content="Configurar" HorizontalAlignment="Left"/><Button x:Name="RefreshData" Grid.Column="1" Content="↻ Atualizar"/></Grid>
  </Grid>
 </Border>
</Window>
