<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI Battery" Width="92" Height="350" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True" Topmost="True" FontWeight="Bold">
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
 <Border CornerRadius="24" BorderThickness="1" Padding="7" BorderBrush="#777D8A"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#202227" Offset="0"/><GradientStop Color="#08090B" Offset="0.36"/><GradientStop Color="#101217" Offset="1"/></LinearGradientBrush></Border.Background>
  <StackPanel x:Name="DockRoot" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
   <StackPanel x:Name="DockLead" VerticalAlignment="Center" HorizontalAlignment="Center">
    <Border x:Name="DragHandle" Padding="7,5" Cursor="SizeAll" ToolTip="Arraste para mover"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Ellipse Width="3" Height="3" Fill="#9A9FAB" Margin="2"/><Ellipse Width="3" Height="3" Fill="#9A9FAB" Margin="2"/><Ellipse Width="3" Height="3" Fill="#9A9FAB" Margin="2"/></StackPanel></Border>
    <TextBlock Text="AI" FontSize="10" Foreground="#949CA9" HorizontalAlignment="Center" Margin="0,2,0,8"/>
   </StackPanel>
   <StackPanel x:Name="AppList"/>
   <StackPanel x:Name="DockControls" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,5">
    <Button x:Name="ToggleOrientation" Content="H" Width="30" Height="29" Padding="0" FontSize="10" Margin="2" ToolTip="Alternar horizontal / vertical"/>
    <Button x:Name="OpenSettings" Content="⚙" Width="30" Height="29" Padding="0" FontSize="17" Margin="2" ToolTip="Configurar conexões e orçamento"/>
    <Button x:Name="ExitMonitor" Content="×" Width="30" Height="26" Padding="0" FontSize="16" Margin="2" Foreground="#949CA9" ToolTip="Encerrar monitor"/>
   </StackPanel>
  </StackPanel>
 </Border>
</Window>