<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AI Battery — configurações" Width="460" Height="730" Background="#0B0C10" Foreground="#E9EDF6" WindowStartupLocation="CenterScreen" Topmost="True" ResizeMode="CanResize" MinHeight="500" MinWidth="420">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#AAB6CC"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,8,0,5"/></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#14161C"/><Setter Property="Foreground" Value="#E9EDF6"/><Setter Property="BorderBrush" Value="#464A55"/><Setter Property="Padding" Value="9"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#E9EDF6"/><Setter Property="Margin" Value="0,12,0,5"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#263044"/><Setter Property="Foreground" Value="#E9EDF6"/><Setter Property="BorderBrush" Value="#464A55"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <Grid Margin="22"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
   <TextBlock x:Name="SettingsTitle" Text="Configurar Codex" FontSize="24" FontWeight="SemiBold" Foreground="#E9EDF6"/>
   <ComboBox x:Name="ProviderPicker" Padding="8"><ComboBoxItem Content="Codex" Tag="codex"/><ComboBoxItem Content="Claude" Tag="claude"/><ComboBoxItem Content="Gemini" Tag="gemini"/></ComboBox>
   <TextBlock Text="Escolha qualquer IA, mesmo fechada. Salve antes de trocar." FontSize="10"/>
   <TextBlock Text="Valores vazios aparecem como —. Credenciais ficam protegidas neste usuário Windows." FontSize="11"/>
   <CheckBox x:Name="AlwaysOnTop" Content="Manter painel sempre por cima"/>
   <TextBlock Text="Orçamento mensal da API (US$)"/><TextBox x:Name="BudgetInput" ToolTip="Exemplo: 50.00"/>
   <TextBlock x:Name="SecretLabel" Text="Chave administrativa da API"/><PasswordBox x:Name="SecretInput" Background="#14161C" Foreground="#E9EDF6" BorderBrush="#464A55" Padding="9"/>
   <TextBlock x:Name="SecretHint" Text="Deixe vazio para manter a credencial salva." FontSize="10"/>
   <CheckBox x:Name="ManualSubscription" Content="Informar saldo da assinatura manualmente"/><TextBox x:Name="SubscriptionInput" ToolTip="Percentual restante entre 0 e 100"/>
   <CheckBox x:Name="ManualApi" Content="Informar gasto mensal da API manualmente"/><TextBox x:Name="ApiInput" ToolTip="Gasto acumulado no mês em US$"/>
   <TextBlock Text="Executável adicional do app ou script CLI (.exe / .js)"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="ExecutableInput"/><Button x:Name="BrowseExecutable" Grid.Column="1" Content="…" Margin="6,0,0,0"/></Grid>
   <StackPanel x:Name="GoogleFields" Visibility="Collapsed"><TextBlock Text="Projeto Google Cloud"/><TextBox x:Name="GoogleProject"/><TextBlock Text="Tabela de exportação existente: projeto.dataset.tabela"/><TextBox x:Name="GoogleTable"/><CheckBox x:Name="EnableGoogleQuery" Content="Permitir consulta BigQuery (pode gerar cobrança)"/><TextBlock Text="Consulta limitada a 100 MB por execução, com cache. Nenhum serviço ou dataset será criado." FontSize="10"/></StackPanel>
   <TextBlock x:Name="SettingsMessage" Foreground="#FF9399"/>
  </StackPanel></ScrollViewer>
  <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="CancelSettings" Content="Cancelar" Margin="0,0,10,0"/><Button x:Name="SaveSettings" Content="Salvar" Background="#324B67"/></StackPanel>
 </Grid>
</Window>
